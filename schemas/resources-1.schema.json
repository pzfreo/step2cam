{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:step2cam:schema:resources:1",
 "title": "step2cam resources (tool library)",
 "description": "Tools, machine capabilities and shop policy for step2cam planning. Optional controller names the intended control; posting is integrated separately.",
 "type": "object",
 "required": [
  "tools"
 ],
 "properties": {
  "format": {
   "const": "step2cam-resources"
  },
  "version": {
   "const": 1
  },
  "tools": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/tool"
   }
  },
  "rapid_mm_min": {
   "type": "number",
   "exclusiveMinimum": 0,
   "description": "The rapid rate the page estimates time with; 5000 when absent."
  },
  "clearance_mm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "retract_mm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "breakthrough_mm": {
   "type": "number",
   "minimum": 0
  },
  "drill_tolerance_mm": {
   "type": "number",
   "minimum": 0
  },
  "radial_allowance_mm": {
   "type": "number",
   "minimum": 0
  },
  "bottom_allowance_mm": {
   "type": "number",
   "minimum": 0
  },
  "cell_size_mm": {
   "type": "number",
   "minimum": 0,
   "description": "The stock grid camlib checks on; 0 or absent for the default."
  },
  "tool_change_gauge_z_mm": {
   "type": "number",
   "description": "Existing setup-frame gauge Z used by the job simulation, not machine-coordinate home Z after a controller tool change. Setup policy, not an installed machine setting."
  },
  "tool_change_xy_mm": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2,
   "description": "Existing setup-frame tool-change XY used by the job simulation; setup policy, not a machine-coordinate home position."
  },
  "overrides": {
   "type": "object",
   "properties": {
    "material": {
     "type": "string",
     "description": "The material the part is cut from, in place of Specify's part.material."
    },
    "workholding_option": {
     "enum": [
      "none",
      "vise_flip_face"
     ],
     "description": "Legacy supplied user choice for setup.workholding: none requests vise_ordinary; vise_flip_face requests that candidate. Absent uses the default choosing rule. Explicit resources.decisions takes precedence; unavailable choices are refused."
    },
    "clamping": {
     "type": "object",
     "description": "Deprecated: use resources.decisions with rule machine.clamping.",
     "additionalProperties": false,
     "properties": {
      "top": {
       "$ref": "#/$defs/clamping_override"
      },
      "bottom": {
       "$ref": "#/$defs/clamping_override"
      },
      "front": {
       "$ref": "#/$defs/clamping_override"
      },
      "back": {
       "$ref": "#/$defs/clamping_override"
      },
      "left": {
       "$ref": "#/$defs/clamping_override"
      },
      "right": {
       "$ref": "#/$defs/clamping_override"
      }
     }
    }
   },
   "additionalProperties": false
  },
  "facing_tool": {
   "type": "string",
   "description": "The id of the end mill for facing; the largest end mill when absent or empty."
  },
  "roughing_tool": {
   "type": "string",
   "description": "The id of the end mill for roughing; the largest end mill when absent or empty."
  },
  "machines": {
   "type": "array",
   "description": "The machines parts are cut on, and what they can do. The planner uses the first mill. The controller's limits stay in machine.",
   "items": {
    "$ref": "#/$defs/machine_capabilities"
   }
  },
  "decisions": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/supplied_decision"
   }
  },
  "roughing_by_group": {
   "type": "object",
   "description": "Sourced bounded-engagement roughing policy by ISO 513 material group. Missing groups use raster.",
   "propertyNames": {
    "enum": [
     "P",
     "M",
     "K",
     "N",
     "S",
     "H"
    ]
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "radial_width_diameter_fraction",
     "axial_flute_fraction",
     "maximum_axial_diameters",
     "chip_thinning",
     "_sources"
    ],
    "properties": {
     "radial_width_diameter_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 0.5
     },
     "axial_flute_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
     },
     "maximum_axial_diameters": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "chip_thinning": {
      "const": "radial_maximum_chip_thickness"
     }
    },
    "patternProperties": {
     "^_": {}
    },
    "additionalProperties": false
   }
  }
 },
 "patternProperties": {
  "^_": {}
 },
