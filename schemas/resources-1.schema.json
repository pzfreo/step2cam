       "type": "number",
       "exclusiveMinimum": 0
      },
      "holder_length": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "holder_diameter": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "spindle_rpm": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "coolant": {
       "enum": [
        "off",
        "flood",
        "mist"
       ]
      },
      "shank_diameter": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "length_register": {
       "type": "integer",
       "minimum": 1
      },
      "type": {
       "const": "tap"
      },
      "diameter": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "Nominal metric thread diameter, not the simulation cutter diameter."
      },
      "pitch": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "hand": {
       "enum": [
        "right",
        "left"
       ],
       "default": "right"
      },
      "tap_type": {
       "enum": [
        "cut",
        "form"
       ]
      },
      "chamfer_form": {
       "type": "string",
       "minLength": 1
      },
      "chamfer_pitches": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "Maximum chamfered pitches, including any incomplete lead; tip extends this many pitches beyond full thread."
      },
      "thread_length": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "flute_style": {
       "enum": [
        "straight",
        "spiral_flute",
        "spiral_point"
       ]
      },
      "cutting_data": {
       "type": "object",
       "propertyNames": {
        "enum": [
