      "plunge_mm_min",
      "stepdown_mm",
      "stepover_mm"
     ],
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1
      },
      "number": {
       "type": "integer",
       "minimum": 1
      },
      "diameter": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "overall_length": {
       "type": "number",
       "exclusiveMinimum": 0
      },
