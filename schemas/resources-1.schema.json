          "type": "number",
          "exclusiveMinimum": 0
         },
         "plunge_mm_min": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "stepdown_mm": {
          "type": "number",
          "exclusiveMinimum": 0
