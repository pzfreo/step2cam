       "type": "number",
       "exclusiveMinimum": 0
      },
      "point_angle": {
       "type": "number",
       "exclusiveMinimum": 0,
       "exclusiveMaximum": 180
      },
      "peck_mm": {
       "type": "number",
       "minimum": 0,
       "description": "Maximum peck increment when the depth rule calls for pecking. Positive values cap the rule increment; 0 or absent means no cap. Shallow holes still use one plunge."
      },
      "cutting_data": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "P",
         "M",
         "K",
         "N",
         "S",
         "H"
        ]
       },
       "additionalProperties": {
        "type": "object",
        "properties": {
         "feed_mm_min": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "spindle_rpm": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "plunge_mm_min": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "stepdown_mm": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "stepover_mm": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        },
        "additionalProperties": false
       },
       "description": "Cutting data for a workpiece material's ISO 513 group, in place of the tool's own."
      },
      "DC": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "ISO 13399 alias for diameter; conflicting paired values are refused by the library reader."
      },
      "OAL": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "ISO 13399 alias for overall_length; conflicting paired values are refused by the library reader."
      },
      "DCONMS": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "ISO 13399 alias for shank_diameter; conflicting paired values are refused by the library reader."
      },
      "LCF": {
       "type": "number",
       "exclusiveMinimum": 0,
       "description": "ISO 13399 alias for flute_length; conflicting paired values are refused by the library reader."
      },
      "SIG": {
       "type": "number",
       "exclusiveMinimum": 0,
       "exclusiveMaximum": 180,
       "description": "ISO 13399 alias for point_angle; conflicting paired values are refused by the library reader."
      }
     },
     "patternProperties": {
      "^_": {}
     },
     "additionalProperties": false,
     "allOf": [
      {
       "anyOf": [
        {
         "required": [
          "diameter"
         ]
        },
        {
         "required": [
          "DC"
         ]
        }
       ]
      },
      {
       "anyOf": [
        {
         "required": [
          "overall_length"
         ]
        },
        {
         "required": [
          "OAL"
         ]
        }
       ]
      },
      {
       "anyOf": [
        {
         "required": [
          "flute_length"
         ]
        },
        {
         "required": [
          "LCF"
         ]
        }
       ]
      },
      {
       "anyOf": [
        {
         "required": [
          "point_angle"
         ]
        },
        {
         "required": [
          "SIG"
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "object",
     "required": [
      "id",
      "type",
      "number",
      "diameter",
      "pitch",
      "tap_type",
      "chamfer_form",
      "chamfer_pitches",
      "thread_length",
      "stickout",
      "holder_length",
      "holder_diameter",
      "spindle_rpm",
      "coolant"
     ],
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1
      },
      "number": {
       "type": "integer",
       "minimum": 1
      },
      "overall_length": {
       "type": "number",
       "exclusiveMinimum": 0
      },
