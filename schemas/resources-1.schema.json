         "stepdown_mm": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "stepover_mm": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        },
        "additionalProperties": false
       },
       "description": "Cutting data for a workpiece material's ISO 513 group, in place of the tool's own."
      }
     },
     "patternProperties": {
