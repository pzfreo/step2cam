{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:step2cam:schema:resources:1",
 "title": "step2cam resources (tool library)",
 "description": "The tools and shop policy values step2cam plans with, and the camlib job is made from: demo/tools.json and examples/tools.example.json. Describes the format as capp (resources.rs, settle.rs) and job.rs read it. There is no machine controller here: step2cam writes no G-code. Every number in the shipped files is a placeholder.",
 "type": "object",
 "required": [
  "tools"
 ],
 "properties": {
  "format": {
   "const": "step2cam-resources"
  },
  "version": {
   "const": 1
  },
  "tools": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/tool"
   }
  },
  "rapid_mm_min": {
   "type": "number",
   "exclusiveMinimum": 0,
   "description": "The rapid rate the page estimates time with; 5000 when absent."
  },
  "clearance_mm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "retract_mm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "breakthrough_mm": {
   "type": "number",
   "minimum": 0
  },
  "drill_tolerance_mm": {
   "type": "number",
   "minimum": 0
  },
  "radial_allowance_mm": {
   "type": "number",
   "minimum": 0
  },
  "bottom_allowance_mm": {
   "type": "number",
   "minimum": 0
  },
  "cell_size_mm": {
   "type": "number",
   "minimum": 0,
   "description": "The stock grid camlib checks on; 0 or absent for the default."
  },
  "tool_change_gauge_z_mm": {
   "type": "number"
  },
  "tool_change_xy_mm": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "overrides": {
   "type": "object",
   "properties": {
    "material": {
     "type": "string",
     "description": "The material the part is cut from, in place of Specify's part.material."
    }
   },
   "additionalProperties": false
  },
  "facing_tool": {
   "type": "string",
   "description": "The id of the end mill for facing; the largest end mill when absent or empty."
  },
  "roughing_tool": {
   "type": "string",
   "description": "The id of the end mill for roughing; the largest end mill when absent or empty."
  }
 },
 "patternProperties": {
  "^_": {}
 },
 "additionalProperties": false,
 "$defs": {
  "tool": {
   "oneOf": [
    {
     "description": "A flat end mill.",
     "type": "object",
     "required": [
      "id",
      "type",
      "number",
      "diameter",
      "overall_length",
      "stickout",
      "holder_length",
      "holder_diameter",
      "feed_mm_min",
      "spindle_rpm",
