       "exclusiveMinimum": 0
      },
      "stepover_mm": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "cutting_data": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "P",
         "M",
         "K",
         "N",
         "S",
         "H"
        ]
       },
       "additionalProperties": {
        "type": "object",
