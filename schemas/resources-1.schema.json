  "machine_capabilities": {
   "type": "object",
   "required": [
    "id",
    "kind"
   ],
   "additionalProperties": false,
   "patternProperties": {
    "^_": {}
   },
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "name": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "mill",
      "lathe"
     ]
    },
    "axes": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "linear": {
       "type": "array",
       "items": {
        "enum": [
         "x",
         "y",
         "z"
        ]
       }
      },
      "rotary": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "travel_mm": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "x": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "y": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "z": {
         "type": "number",
         "exclusiveMinimum": 0
        }
       }
      }
     }
    },
    "spindle": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "max_rpm": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "power_kw": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "taper": {
       "type": "string"
      },
      "max_tool_diameter_mm": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "max_bar_diameter_mm": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "collet_change": {
       "enum": [
        "manual",
        "automatic"
       ],
       "description": "How spindle collets are changed, independently of the tool changer. manual requires operator intervention when selected shank sizes differ; absent leaves this check unspecified. Not needed for ATCs swapping complete preassembled holders."
      }
     }
    },
    "tool_changer": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "automatic",
        "manual",
        "turret"
       ]
      },
      "pockets": {
       "type": "integer",
       "minimum": 1
      }
     }
    },
    "coolant": {
     "type": "array",
     "items": {
      "enum": [
       "flood",
       "mist",
       "air",
       "through_spindle"
      ]
     }
    },
    "workholding": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "kind"
      ],
      "additionalProperties": false,
      "properties": {
       "kind": {
        "enum": [
         "vise",
         "fixture",
         "chuck",
         "collet"
        ]
       },
       "max_jaw_opening_mm": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "max_diameter_mm": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "jaw_width_mm": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "jaw_height_mm": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "parallels_height_mm": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     }
    },
    "controller": {
     "type": "string",
     "description": "Optional controller identifier, e.g. haas_ngc, linuxcnc or carvera. Metadata pending browser posting; an identifier does not enable output."
    },
    "controller_settings": {
     "$ref": "#/$defs/controller_settings"
    }
   },
   "allOf": [
    {
     "if": {
      "required": [
       "controller"
      ],
      "properties": {
       "controller": {
        "const": "haas_ngc"
       }
      }
     },
     "else": {
      "properties": {
       "controller_settings": {
        "not": {
         "anyOf": [
          {
           "required": [
            "setting_33_coordinate_system"
           ]
          },
          {
           "required": [
            "setting_15_h_and_t_code_agreement"
           ]
          },
          {
           "required": [
            "setting_22_can_cycle_delta_z_mm"
           ]
          },
          {
           "required": [
            "setting_52_g83_retract_above_r_mm"
           ]
          },
          {
           "required": [
            "g92_coordinate_shift_mm"
           ]
          },
          {
           "required": [
            "rotation_and_scaling_option"
           ]
          },
          {
           "required": [
            "rigid_tapping_option"
           ]
          },
          {
           "required": [
            "optional_stop_switch_enabled"
           ]
          },
          {
           "required": [
            "setting_45_46_47_mirror_image_xyz"
           ]
          }
         ]
        }
       }
      }
     }
    }
   ]
  },
  "clamping_override": {
   "type": "object",
   "required": [
    "axis",
    "grip_height_mm"
   ],
   "additionalProperties": false,
   "properties": {
    "axis": {
     "enum": [
      "x",
      "y"
     ],
     "description": "The setup-frame axis across which the jaws close; selects that stock axis min/max faces."
    },
    "grip_height_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "parallels_height_mm": {
     "type": [
      "number",
      "null"
     ],
     "exclusiveMinimum": 0
    }
   }
  },
  "supplied_decision": {
   "type": "object",
   "required": [
    "rule",
    "subject",
    "choice",
    "source",
    "reason"
   ],
   "properties": {
    "rule": {
     "type": "string",
     "pattern": "^[a-z_]+(\\.[a-z_]+)+(@[0-9]+)?$"
    },
    "subject": {
     "type": "string"
    },
    "operation": {
     "type": "string"
    },
    "choice": {},
    "source": {
     "type": "string",
     "pattern": "^(user|agent|agent:.+)$"
    },
    "reason": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "controller_settings": {
   "type": "object",
   "additionalProperties": false,
   "patternProperties": {
    "^_": {}
   },
   "properties": {
    "max_cutting_feed_mm_min": {
     "type": "number",
     "description": "Maximum cutting feed. Source: machine feedrate specification, or LinuxCNC [TRAJ] MAX_VELOCITY converted from machine units/s to mm/min.",
     "exclusiveMinimum": 0
    },
    "highest_tool_number": {
     "type": "integer",
     "description": "Highest addressable tool identity, independent of physical pockets. Source: controller tool table manual.",
     "minimum": 1
    },
    "highest_length_offset_number": {
     "type": "integer",
     "description": "Highest addressable tool length offset. Source: controller offset table manual.",
     "minimum": 1
    },
    "tool_change_location": {
     "type": "string",
     "description": "Position semantics after the controller completes a tool change: declared_position uses setup tool positions, unchanged_tip preserves the tip, machine_z_home homes the gauge line. Source: controller tool-change configuration (LinuxCNC INI [EMCIO]).",
     "enum": [
      "declared_position",
      "unchanged_tip",
      "machine_z_home"
     ]
    },
    "tool_change_gauge_home_z_mm": {
     "type": "number",
     "description": "Gauge line machine Z after a homing tool change, not a commanded pre-change retract. Source: installed tool-change configuration."
    },
    "normal_acceleration_limit_mm_s2": {
     "type": "number",
     "description": "Maximum normal acceleration of the nominal cutting path. Source: measured/configured machine motion limits; not inferred from rapid speed.",
     "exclusiveMinimum": 0
    },
    "axis_feed_limits_mm_min": {
     "type": "array",
     "description": "Independent XYZ feed limits. Source: machine axis specifications or LinuxCNC [AXIS_*] MAX_VELOCITY, converted to mm/min.",
     "items": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "minItems": 3,
     "maxItems": 3
    },
    "required_output_units": {
     "type": "string",
     "description": "Only when the controller fixes dimensional units. Source: Carvera community firmware G-code reference (G20 halts; G21 millimetres). Omit for controls supporting both.",
     "enum": [
      "mm",
      "inch"
     ]
    },
    "setting_33_coordinate_system": {
     "type": "string",
     "enum": [
      "fanuc",
      "haas"
     ],
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Setting 33 Coordinate System."
    },
    "setting_15_h_and_t_code_agreement": {
     "type": "boolean",
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Setting 15 H and T Code Agreement."
    },
    "setting_22_can_cycle_delta_z_mm": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Setting 22 Can Cycle Delta Z."
    },
    "setting_52_g83_retract_above_r_mm": {
     "type": "number",
     "minimum": 0,
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Setting 52 G83 Retract Above R."
    },
    "g92_coordinate_shift_mm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3,
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, G92 Set Work Coordinate Systems Shift Value; current XYZ shift."
    },
    "rotation_and_scaling_option": {
     "type": "boolean",
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Rotation and Scaling option, G68/G69 and G50/G51."
    },
    "rigid_tapping_option": {
     "type": "boolean",
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Rigid Tapping option, G84/G74."
    },
    "optional_stop_switch_enabled": {
     "type": "boolean",
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Setting 17 / OPTIONAL STOP panel state."
    },
    "setting_45_46_47_mirror_image_xyz": {
     "type": "array",
     "items": {
      "type": "boolean"
     },
     "minItems": 3,
     "maxItems": 3,
     "description": "Haas NGC installed value, not an assumed default. Source: Haas mill operator manual 96-8210 Rev N, Settings 45, 46, 47 Mirror Image X/Y/Z."
    }
   },
   "description": "Installed machine controller settings. Omitted means unknown, never a default. Sources and observed versus catalogue values belong in _sources/_comment.",
   "allOf": [
    {
     "if": {
      "required": [
       "tool_change_location"
      ],
      "properties": {
       "tool_change_location": {
        "const": "machine_z_home"
       }
      }
     },
     "then": {
      "required": [
       "tool_change_gauge_home_z_mm"
      ]
     },
     "else": {
      "not": {
       "required": [
        "tool_change_gauge_home_z_mm"
       ]
      }
     }
    }
   ]
  }
 }
}
