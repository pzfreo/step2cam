{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:step2cam:schema:resources:1",
 "title": "step2cam resources (tool library)",
 "description": "The machine, tools and shop policy values step2cam plans and posts with: demo/tools.json and examples/tools.example.json. Describes the format as capp (resources.rs, settle.rs), job.rs and post.rs read it. Every number in the shipped files is a placeholder.",
 "type": "object",
 "required": [
  "machine",
  "tools"
 ],
 "properties": {
  "format": {
   "const": "step2cam-resources"
  },
  "version": {
   "const": 1
  },
  "machine": {
   "$ref": "#/$defs/machine"
  },
  "tools": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/tool"
   }
  },
  "clearance_mm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "retract_mm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "breakthrough_mm": {
   "type": "number",
   "minimum": 0
  },
  "drill_tolerance_mm": {
   "type": "number",
   "minimum": 0
  },
  "radial_allowance_mm": {
   "type": "number",
   "minimum": 0
  },
  "bottom_allowance_mm": {
   "type": "number",
   "minimum": 0
  },
  "cell_size_mm": {
   "type": "number",
   "minimum": 0,
   "description": "The stock grid camlib checks on; 0 or absent for the default."
  },
  "tool_change_gauge_z_mm": {
   "type": "number"
  },
  "tool_change_xy_mm": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "overrides": {
   "type": "object",
   "properties": {
    "material": {
     "type": "string",
     "description": "The material the part is cut from, in place of Specify's part.material."
    }
   },
   "additionalProperties": false
  },
  "facing_tool": {
   "type": "string",
   "description": "The id of the end mill for facing; the largest end mill when absent or empty."
  },
  "roughing_tool": {
   "type": "string",
   "description": "The id of the end mill for roughing; the largest end mill when absent or empty."
  },
  "machines": {
   "type": "array",
   "description": "The machines parts are cut on, and what they can do. The planner uses the first mill. The controller's limits stay in machine.",
   "items": {
    "$ref": "#/$defs/machine_capabilities"
   }
  },
  "turning": {
   "type": "object",
   "additionalProperties": false,
   "patternProperties": {
    "^_": {}
   },
   "description": "The shop's turning allowances.",
   "properties": {
    "bar_oversize_mm": {
     "type": "number",
     "minimum": 0
    },
    "face_allowance_mm": {
     "type": "number",
     "minimum": 0
    },
    "part_off_allowance_mm": {
     "type": "number",
     "minimum": 0
    },
    "allowance_mm": {
     "type": "number",
     "minimum": 0
    }
   }
  }
 },
 "patternProperties": {
  "^_": {}
 },
 "additionalProperties": false,
 "$defs": {
  "machine": {
   "type": "object",
   "required": [
    "decimals",
    "max_feed_mm_min",
    "max_spindle_rpm",
    "tool_change_position_mode"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "dialect": {
     "const": "linuxcnc"
    },
    "output_units": {
     "const": "mm"
    },
    "decimals": {
     "type": "integer",
     "minimum": 0
    },
    "max_feed_mm_min": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "max_spindle_rpm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "rapid_mm_min": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "planes": {
     "type": "array",
     "items": {
      "enum": [
       "xy",
       "xz",
       "yz"
      ]
     }
    },
    "arcs": {
     "type": "boolean"
    },
    "helices": {
     "type": "boolean"
    },
    "max_sweep_rad": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "max_tool_number": {
     "type": "integer",
     "minimum": 1
    },
    "max_length_register": {
     "type": "integer",
     "minimum": 1
    },
    "tolerance_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "feed_tolerance_mm_min": {
     "type": "number",
     "minimum": 0
    },
    "tool_changes": {
     "type": "boolean"
    },
    "flood": {
     "type": "boolean"
    },
    "mist": {
     "type": "boolean"
    },
    "tool_change_position_mode": {
     "const": "table",
     "description": "The only mode wired up."
    }
   },
   "patternProperties": {
    "^_": {}
   },
   "additionalProperties": false
  },
  "tool": {
